<?xml version="1.0" encoding="utf-8"?>
<!-- Test APK only. A real account type for import tests: the contacts provider strips rows of an
     account type AccountManager does not know whenever the device's accounts change. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="org.kysecurity.mail.contacts.device.TestAccountAuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/test_account_authenticator" />
        </service>
    </application>
</manifest>

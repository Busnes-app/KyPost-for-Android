<?xml version="1.0" encoding="utf-8"?>
<!-- Settings as list rows: icon, title over description, chevron, one hairline between rows.
     The row carries the old button's id and click; SettingsActivity themes it (applyListRowTheme). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/settingsSecurity"
        style="@style/Widget.KyPost.ListRow">

        <ImageView
            style="@style/Widget.KyPost.ListRowIcon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_row_security" />

        <LinearLayout style="@style/Widget.KyPost.ListRowText">

            <TextView
                style="@style/Widget.KyPost.ListRowTitle"
                android:text="@string/menu_security" />

            <TextView
                android:id="@+id/settingsSecurityBody"
                style="@style/Widget.KyPost.ListRowBody"
                android:text="@string/settings_security_body" />
        </LinearLayout>

        <ImageView
            style="@style/Widget.KyPost.ListRowChevron"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <View style="@style/Widget.KyPost.ListRowDivider" />

    <LinearLayout

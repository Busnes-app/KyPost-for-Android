<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/settingsSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_security" />

            <TextView
                android:id="@+id/settingsSecurityBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_security_body" />

            <Button
                android:id="@+id/settingsThemes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_themes" />

            <TextView
                android:id="@+id/settingsThemesBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_themes_body" />

            <Button
                android:id="@+id/settingsKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_keywords" />

            <TextView
                android:id="@+id/settingsKeywordsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_keywords_body" />

            <Button
                android:id="@+id/settingsPairing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_pairing" />

            <TextView
                android:id="@+id/settingsPairingBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_pairing_body" />

            <Button
                android:id="@+id/settingsPgp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_pgp_key" />

            <TextView
                android:id="@+id/settingsPgpBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_pgp_body" />

            <Button
                android:id="@+id/settingsAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_about" />

            <TextView
                android:id="@+id/settingsAboutBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_about_body" />

            <Button
                android:id="@+id/settingsPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_privacy" />

            <TextView
                android:id="@+id/settingsPrivacyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_privacy_body" />

            <Button
                android:id="@+id/settingsSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_support" />

            <TextView
                android:id="@+id/settingsSupportBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_support_body" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>

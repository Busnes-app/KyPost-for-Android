<?xml version="1.0" encoding="utf-8"?>
<!-- Compose on a 600dp+ window: still one column, centred and capped at
     compose_column_max_width, with the format bar under Subject instead of docked at the
     bottom. Never two columns: an email reads top to bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/composeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- tools:ignore="InconsistentLayout": composeContent is deliberately only in the rail
         layouts (this one and activity_compose_rail), where a nav rail sits beside the content.
         ComposeActivity reads it as
         `findViewById<View?>(R.id.composeContent) ?: rootView`, so the phone layout's absence is
         the documented path, not a missing widget. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/composeContent"
        tools:ignore="InconsistentLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <org.kysecurity.mail.ComposeColumn
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <include layout="@layout/compose_send_off_notice" />

            <include layout="@layout/compose_header" />

            <include layout="@layout/compose_format_bar" />

            <View
                android:id="@+id/composeFormatBarDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <include layout="@layout/compose_editor" />

        </org.kysecurity.mail.ComposeColumn>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/bottomNavigation"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>

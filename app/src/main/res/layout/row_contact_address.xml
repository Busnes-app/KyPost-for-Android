<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <EditText
            android:id="@+id/rowAddressLabel"
            android:imeOptions="flagNoPersonalizedLearning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:hint="@string/contacts_address_label_hint"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/rowAddressStreet"
            android:imeOptions="flagNoPersonalizedLearning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:hint="@string/contacts_address_street_hint"
            android:importantForAutofill="no"
            android:inputType="textPostalAddress" />

        <EditText
            android:id="@+id/rowAddressCity"
            android:imeOptions="flagNoPersonalizedLearning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:hint="@string/contacts_address_city_hint"
            android:importantForAutofill="no"
            android:inputType="textPostalAddress|textCapWords" />

        <EditText
            android:id="@+id/rowAddressRegion"
            android:imeOptions="flagNoPersonalizedLearning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:hint="@string/contacts_address_region_hint"
            android:importantForAutofill="no"
            android:inputType="textPostalAddress|textCapWords" />

        <EditText
            android:id="@+id/rowAddressPostalCode"
            android:imeOptions="flagNoPersonalizedLearning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:hint="@string/contacts_address_postal_code_hint"
            android:importantForAutofill="no"
            android:inputType="textPostalAddress|textCapCharacters" />

        <EditText
            android:id="@+id/rowAddressCountry"
            android:imeOptions="flagNoPersonalizedLearning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/contacts_address_country_hint"
            android:importantForAutofill="no"
            android:inputType="textPostalAddress|textCapWords" />

    </LinearLayout>

    <TextView
        android:id="@+id/rowAddressRemove"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="@string/contacts_field_remove_glyph"
        android:textSize="18sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/contacts_field_remove_cd" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The phone Compose body, shared by activity_compose (bottom bar) and activity_compose_rail (rail
     beside it on a 440-600dp notlong window). The format bar sits under the scroll, so with the
     keyboard up it rides just above it. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One scroll for header and body together: on a short window (a closed foldable with the
         keyboard up) the recipient rows can slide off the top instead of squeezing the body out. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <org.kysecurity.mail.ComposeColumn
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <include layout="@layout/compose_send_off_notice" />

            <include layout="@layout/compose_header" />

            <include layout="@layout/compose_editor" />

        </org.kysecurity.mail.ComposeColumn>

    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/composeFormatBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <include layout="@layout/compose_format_bar" />

</merge>

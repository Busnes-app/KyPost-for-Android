<?xml version="1.0" encoding="utf-8"?>
<!-- Why Send is off, said where the user is looking, with the way out beside it. Shown only while
     the account's encryption settings could not be checked; painted from the warning tone. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/composeSendOffNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/composeSendOffIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warning" />

        <TextView
            android:id="@+id/composeSendOffText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/composeSendOffRetry"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:text="@string/compose_custody_retry" />

    </LinearLayout>

</merge>

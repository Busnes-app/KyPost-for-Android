<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Deliberately not DayNight; AppTheme.kt paints palettes at runtime. -->
    <style name="Theme.KyPost" parent="Theme.MaterialComponents">
        <!-- Also drives AlertDialog button text; must stay legible against colorSurface. -->
        <item name="colorPrimary">@color/teal_200</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/app_chrome_surface</item>
        <item name="colorOnSurface">@color/app_chrome_on_surface</item>
        <item name="android:colorBackground">@color/app_chrome_surface</item>
        <!-- No android:statusBarColor. It is deprecated in API 35 and ignored under the
             edge-to-edge that targetSdk 36 enforces; the status bar is transparent and the window
             background painted by applyThemeToActivity shows through it instead. -->
        <!-- Space Grotesk is the default UI typeface app-wide, mirroring web's sans font var.
             IBM Plex Mono is applied per-view where the guide calls for a monospace field. -->
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
    </style>

    <!-- Bottom nav has no icons (bottom_nav_menu.xml is label-only), so its default text weight
         reads faint against a full label-only bar; bump it for legibility. -->
    <style name="TextAppearance.KyPost.BottomNavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chip's default padding budgets room for a label, off-centering an icon-only chip. -->
    <style name="Widget.KyPost.IconOnlyChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="iconStartPadding">0dp</item>
        <item name="iconEndPadding">0dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="android:text"></item>
    </style>

    <!-- Compose's format bar: an icon on no fill until it is on (applyFormatChipTheme). -->
    <style name="Widget.KyPost.FormatChip" parent="Widget.KyPost.IconOnlyChip">
        <item name="android:layout_marginEnd">2dp</item>
        <item name="chipIconSize">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
    </style>
</resources>
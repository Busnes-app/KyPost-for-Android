<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Deliberately not DayNight; AppTheme.kt paints palettes at runtime. -->
    <style name="Theme.KyPost" parent="Theme.MaterialComponents">
        <!-- Also drives AlertDialog button text; must stay legible against colorSurface. -->
        <item name="colorPrimary">@color/teal_200</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/app_chrome_surface</item>
        <item name="colorOnSurface">@color/app_chrome_on_surface</item>
        <item name="android:colorBackground">@color/app_chrome_surface</item>
        <!-- No android:statusBarColor. It is deprecated in API 35 and ignored under the
             edge-to-edge that targetSdk 36 enforces; the status bar is transparent and the window
             background painted by applyThemeToActivity shows through it instead. -->
        <!-- Space Grotesk is the default UI typeface app-wide, mirroring web's sans font var.
             IBM Plex Mono is applied per-view where the guide calls for a monospace field. -->
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <!-- Sentence-case labels everywhere, dialog buttons included; never ALL-CAPS tracked. -->
        <item name="textAppearanceButton">@style/TextAppearance.KyPost.Button</item>
    </style>

    <style name="TextAppearance.KyPost.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Bottom nav has no icons (bottom_nav_menu.xml is label-only), so its default text weight
         reads faint against a full label-only bar; bump it for legibility. -->
    <style name="TextAppearance.KyPost.BottomNavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chip's default padding budgets room for a label, off-centering an icon-only chip. -->
    <style name="Widget.KyPost.IconOnlyChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="iconStartPadding">0dp</item>
        <item name="iconEndPadding">0dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="android:text"></item>
    </style>

    <!-- Compose's format bar: an icon on no fill until it is on (applyFormatChipTheme). -->
    <style name="Widget.KyPost.FormatChip" parent="Widget.KyPost.IconOnlyChip">
        <item name="android:layout_marginEnd">2dp</item>
        <item name="chipIconSize">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
    </style>

    <!-- A navigation list row (Settings): 72dp, icon, title over description, chevron. -->
    <style name="Widget.KyPost.ListRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.KyPost.ListRowIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">20dp</item>
    </style>

    <style name="Widget.KyPost.ListRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.KyPost.ListRowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.KyPost.ListRowBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.KyPost.ListRowChevron" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:src">@drawable/ic_row_chevron</item>
    </style>

    <!-- Hairline between rows, starting at the title (16 + 24 + 20). -->
    <style name="Widget.KyPost.ListRowDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">60dp</item>
    </style>
</resources>
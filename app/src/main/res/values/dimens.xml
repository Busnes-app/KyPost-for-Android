<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- STYLE_GUIDE.md §3 Card/panel radius — shared with iOS Shape.panel / Linux shapePanel (both 14). -->
    <dimen name="card_corner_radius">14dp</dimen>
    <!-- Eight of these share the message action row: 8 x 35dp fits a 320dp phone's 288dp, with
         room for pixel rounding. -->
    <dimen name="detail_action_size">35dp</dimen>
    <dimen name="detail_action_padding">8dp</dimen>
    <!-- Compose header rows share these so To, Cc, Bcc and Subject boxes start and end on the same
         lines: every label is at least this wide ("Subject" at 12sp is ~48dp), and every row keeps
         the address-book button's slot (32dp + 4dp margin) even where the button is hidden. -->
    <dimen name="compose_field_label_width">64dp</dimen>
    <dimen name="compose_row_min_height">52dp</dimen>
    <!-- Compose is one column; on a wide window it stops here and centres. -->
    <dimen name="compose_column_max_width">720dp</dimen>
</resources>
